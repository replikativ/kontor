 {:code "2221.01.10" :path "Liabilities:Tax:VAT:TaxReduction"
  :name "Tax reduction / 减免税款"
  :type :liability
  :external-codes {:cn/asbe "2221.01.10"
                   :cn/asbe-column "减免税款"}}

 ;; Non-MOF-statutory column — POST-2019 加计抵减 policy
 ;; (Cai Shui [2019] No. 87 + renewals). NOT in the 10-column list of
 ;; Cai Kuai [2016] No. 22; numbered 2221.01.99 so its non-statutory
 ;; status is obvious. Policy-driven, periodically extended; verify
 ;; applicability per current taxable period.
 {:code "2221.01.99" :path "Liabilities:Tax:VAT:AdditionalDeduction"
  :name "Additional input deduction / 进项税加计抵减"
  :type :liability
  :external-codes {:cn/asbe-column "进项税加计抵减"}}

 ;; 2221.02 - 2221.10: 二级 detail accounts under 应交税费
 ;; (NOT columns inside 2221.01 应交增值税).
 {:code "2221.02" :path "Liabilities:Tax:VAT:Unpaid"
  :name "Unpaid VAT / 未交增值税"
  :type :liability
  :tags [:cn-vat-net-payable]
  :external-codes {:cn/asbe "2221.02"}}
 {:code "2221.03" :path "Liabilities:Tax:VAT:Prepaid"
  :name "Prepaid VAT / 预交增值税"
  :type :liability
  :external-codes {:cn/asbe "2221.03"}}
 {:code "2221.04" :path "Assets:Tax:VAT:PendingDeduction"
  :name "Pending-deduction input VAT / 待抵扣进项税额"
  :type :asset
  :external-codes {:cn/asbe "2221.04"}}
 {:code "2221.05" :path "Assets:Tax:VAT:PendingCertification"
  :name "Pending-certification input VAT / 待认证进项税额"
  :type :asset
  :external-codes {:cn/asbe "2221.05"}}
 {:code "2221.06" :path "Liabilities:Tax:VAT:PendingTransferOutput"
  :name "Pending-transfer output / 待转销项税额"
  :type :liability
  :external-codes {:cn/asbe "2221.06"}}
 {:code "2221.07" :path "Assets:Tax:VAT:RetainedCredit"
  :name "Retained input credit / 留抵税额"
  :type :asset
  :external-codes {:cn/asbe "2221.07"}}
 {:code "2221.09" :path "Liabilities:Tax:VAT:Simplified"
  :name "Simplified taxation / 简易计税"
  :type :liability
  :external-codes {:cn/asbe "2221.09"}}
 {:code "2221.10" :path "Liabilities:Tax:VAT:WithheldRemitted"
  :name "Withheld-and-remitted VAT / 代扣代交增值税"
  :type :liability
  ;; Booked when buying cross-border services and acting as
  ;; withholding agent (扣缴义务人). Settles separately to the STA
  ;; rather than netting through 销项/进项. Confirmed as a 二级
  ;; detail account (NOT a 应交增值税 memo-column) per second-pass
  ;; CN verification.
  :external-codes {:cn/asbe "2221.10"}}

 ;; 2221.11+ — other tax sub-accounts (CIT + surcharges + others)
 {:code "2221.11" :path "Liabilities:Tax:CIT"
