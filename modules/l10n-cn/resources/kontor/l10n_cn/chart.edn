  :external-codes {:cn/asbe "2221.15"}}
 {:code "2221.16" :path "Liabilities:Tax:StampDuty"
  :name "Stamp duty / 印花税"
  :type :liability
  ;; NOTE: Chinese practitioner convention typically expenses stamp duty
  ;; directly to 税金及附加 at payment time WITHOUT accruing through
  ;; 应交税费 (no statutory accrual basis — due at document execution).
  ;; This account supports the alternate "accrue first, pay later"
  ;; treatment, but most enterprises won't use it.
  :external-codes {:cn/asbe "2221.16"}}

 {:code "2401" :path "Liabilities:Loan:Long"
  :name "Long-term borrowings / 长期借款"
