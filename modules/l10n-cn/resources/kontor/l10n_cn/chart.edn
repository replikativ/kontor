;; China — ASSBE (Accounting Standards for Small Business Enterprises)
;; chart of accounts. 4-digit base codes + standard sub-accounts under
;; 2221 应交税费 per MOF Cai Kuai [2006] No. 18 + the ASSBE 2013
;; small-business companion document.
;;
;; ASBE-large companion (4xxx equity + 6xxx P&L classified) is
;; deferred to a sibling `kontor-l10n-cn-asbe-large` per the BR/CN
;; agent advice — keep this module focused on ASSBE.
;;
;; ## 2221 应交税费 sub-tree (the MOF-canonical structure)
;;
;; Per-rate aggregation (13% / 9% / 6%) is via :kontor.tax-application/rate
;; (ADR-016) + per-posting account-tags, NOT via per-rate accounts.
;; The MOF chart has ONE output-VAT account and ONE input-VAT account;
;; this kernel previously had non-standard per-rate sub-accounts —
;; corrected 2026-05-11 per CN verification agent's gap analysis.
;;
;; ## Numeric-code convention (kontor-internal)
;;
;; MOF Cai Kuai [2016] No. 22 names the detail accounts as **专栏
;; (memo-columns)** under `应交税费——应交增值税` — without numeric
;; suffixes. The `2221.01.NN` codes here are kontor's internal
;; flattening of MOF's column convention; mapping is 1:1 to MOF's
;; column names but **not statutory**. Exports to Chinese
;; accounting-software interchange formats should use the column-NAME
;; form, not the numeric code. `:cn/asbe-column` carries the statutory
;; Chinese name alongside `:cn/asbe` for that case.
;;
;; Sub-accounts 2221.11-2221.16 (CIT + surcharges + others) use
;; kontor-internal ordering — MOF doesn't prescribe numbers below
;; 2221.10. Different Chinese ERPs use different orderings.
;;
;; Per Cai Kuai [2016] No. 22, 应交增值税 has 10 statutory **专栏
;; (memo-columns)**. 代扣代交增值税 and 简易计税 are SEPARATE 二级
;; detail accounts under 应交税费 — NOT columns inside 应交增值税.
;; Corrected 2026-05-11 per second-pass CN verification.
;;
;; 2221.01 应交增值税 — the 10 MOF-canonical 专栏:
;;   2221.01.01 销项税额                       Output VAT (collected on sales)
;;   2221.01.02 进项税额                       Input VAT (paid on purchases)
;;   2221.01.03 销项税额抵减                   Output VAT offset (差额征税)
;;   2221.01.04 进项税额转出                   Input VAT reversal
;;   2221.01.05 出口退税                       Export tax refund
;;   2221.01.06 出口抵减内销产品应纳税额        Export-offset domestic VAT
;;   2221.01.07 转出未交增值税                 Transferred unpaid VAT
;;   2221.01.08 转出多交增值税                 Transferred excess VAT
;;   2221.01.09 已交税金                       Taxes paid (intra-period)
;;   2221.01.10 减免税款                       Tax reduction
;;   2221.01.99 进项税加计抵减                 Additional input deduction
;;                                            (POST-2019, Cai Shui [2019] No. 87)
;;                                            — NOT in the original 10; numbered
;;                                            .99 so its non-statutory status is
;;                                            obvious. Policy-driven, periodically
;;                                            extended.
;;
;; 二级 detail accounts under 2221 应交税费 (NOT columns inside 应交增值税):
;;   2221.02 未交增值税            Unpaid VAT (period-close balance)
;;   2221.03 预交增值税            Prepaid VAT
;;   2221.04 待抵扣进项税额        Pending-deduction input
;;   2221.05 待认证进项税额        Pending-certification input
;;   2221.06 待转销项税额          Pending-transfer output
;;   2221.07 留抵税额              Retained credit (transitional 营改增 carryforwards;
;;                                  many firms no longer use)
;;   2221.09 简易计税              Simplified taxation
;;   2221.10 代扣代交增值税        Withheld-and-remitted VAT (cross-border services)
;;   2221.11 应交所得税            Corporate Income Tax payable
;;   2221.12 城建税                Urban Maintenance & Construction Tax
;;   2221.13 教育费附加            Education surcharge
;;   2221.14 地方教育费附加        Local education surcharge
;;   2221.15 消费税                Consumption tax (specific products)
;;   2221.16 印花税                Stamp duty
;;
;; Per ADR-019, every account carries `:external-codes` so the
;; statutory MOF code is queryable.

[
 ;; ---------- 1xxx Assets / 资产 ----------
 {:code "1001" :path "Assets:Cash:OnHand"
  :name "Cash on hand / 库存现金"
  :type :asset :reconcilable? false
  :external-codes {:cn/asbe "1001"}}
 {:code "1002" :path "Assets:Bank:Deposits"
  :name "Bank deposits / 银行存款"
  :type :asset :reconcilable? true
  :external-codes {:cn/asbe "1002"}}
 {:code "1121" :path "Assets:Receivable:Notes"
  :name "Notes receivable / 应收票据"
  :type :asset
  :external-codes {:cn/asbe "1121"}}
 {:code "1122" :path "Assets:Receivable"
  :name "Accounts receivable / 应收账款"
  :type :asset :reconcilable? true
  :external-codes {:cn/asbe "1122"}}
 {:code "1123" :path "Assets:Prepayments"
  :name "Prepayments / 预付账款"
  :type :asset
  :external-codes {:cn/asbe "1123"}}
 {:code "1221" :path "Assets:Receivable:Other"
  :name "Other receivables / 其他应收款"
  :type :asset
  :external-codes {:cn/asbe "1221"}}
 {:code "1231" :path "Assets:Receivable:Allowance"
  :name "Allowance for doubtful debts / 坏账准备"
  :type :asset                                            ;; contra
  :external-codes {:cn/asbe "1231"}}
 {:code "1403" :path "Assets:Inventory:RawMaterials"
  :name "Raw materials / 原材料"
  :type :asset
  :external-codes {:cn/asbe "1403"}}
 {:code "1405" :path "Assets:Inventory:Finished"
  :name "Inventory / finished goods / 库存商品"
  :type :asset
  :external-codes {:cn/asbe "1405"}}
 {:code "1406" :path "Assets:Inventory:WIP"
  :name "Work in progress / 在产品"
  :type :asset
  :external-codes {:cn/asbe "1406"}}
 {:code "1601" :path "Assets:Fixed"
  :name "Fixed assets / 固定资产"
  :type :asset
  :external-codes {:cn/asbe "1601"}}
 {:code "1602" :path "Assets:Fixed:AccumDep"
  :name "Accumulated depreciation / 累计折旧"
  :type :asset                                            ;; contra
  :external-codes {:cn/asbe "1602"}}
 {:code "1604" :path "Assets:Fixed:ConstructionInProgress"
  :name "Construction in progress / 在建工程"
  :type :asset
  :external-codes {:cn/asbe "1604"}}
 {:code "1701" :path "Assets:Intangible"
  :name "Intangible assets / 无形资产"
  :type :asset
  :external-codes {:cn/asbe "1701"}}
 {:code "1702" :path "Assets:Intangible:AccumAmort"
  :name "Accumulated amortization / 累计摊销"
  :type :asset
  :external-codes {:cn/asbe "1702"}}

 ;; ---------- 2xxx Liabilities / 负债 ----------
 {:code "2001" :path "Liabilities:Loan:Short"
  :name "Short-term borrowings / 短期借款"
  :type :liability
  :external-codes {:cn/asbe "2001"}}
 {:code "2201" :path "Liabilities:Payable:Notes"
  :name "Notes payable / 应付票据"
  :type :liability
  :external-codes {:cn/asbe "2201"}}
 {:code "2202" :path "Liabilities:Payable"
  :name "Accounts payable / 应付账款"
  :type :liability :reconcilable? true
  :external-codes {:cn/asbe "2202"}}
 {:code "2203" :path "Liabilities:Advances"
  :name "Advances from customers / 预收账款"
  :type :liability
  :external-codes {:cn/asbe "2203"}}
 {:code "2211" :path "Liabilities:EmployeeComp"
  :name "Employee compensation payable / 应付职工薪酬"
  :type :liability
  :external-codes {:cn/asbe "2211"}}

 ;; ---------- 2221 应交税费 — MOF-canonical sub-tree ----------
 {:code "2221" :path "Liabilities:Tax"
  :name "Taxes payable / 应交税费"
  :type :liability
  :external-codes {:cn/asbe "2221"}}

 ;; 2221.01 应交增值税 — the 10 MOF-canonical 专栏
 ;; (Cai Kuai [2016] No. 22). Per-rate aggregation (13% / 9% / 6%) is
 ;; via :kontor.tax-application/rate + revenue-account tags, NOT via per-rate
 ;; output accounts.
 {:code "2221.01.01" :path "Liabilities:Tax:VAT:OutputVAT"
  :name "Output VAT / 销项税额"
  :type :liability
  :tags [:cn-vat-output]
  :external-codes {:cn/asbe "2221.01.01"
                   :cn/asbe-column "销项税额"}}
 {:code "2221.01.02" :path "Assets:Tax:VAT:InputVAT"
  :name "Input VAT (deductible) / 进项税额"
  :type :asset
  :tags [:cn-vat-input]
  :external-codes {:cn/asbe "2221.01.02"
                   :cn/asbe-column "进项税额"}}
 {:code "2221.01.03" :path "Liabilities:Tax:VAT:OutputOffset"
  :name "Output VAT offset / 销项税额抵减"
  :type :liability
  :external-codes {:cn/asbe "2221.01.03"
                   :cn/asbe-column "销项税额抵减"}}
 {:code "2221.01.04" :path "Liabilities:Tax:VAT:InputReversal"
  :name "Input VAT reversal / 进项税额转出"
  :type :liability
  :external-codes {:cn/asbe "2221.01.04"
                   :cn/asbe-column "进项税额转出"}}
 {:code "2221.01.05" :path "Assets:Tax:VAT:ExportRefund"
  :name "Export tax refund / 出口退税"
  :type :asset
  :external-codes {:cn/asbe "2221.01.05"
                   :cn/asbe-column "出口退税"}}
 {:code "2221.01.06" :path "Liabilities:Tax:VAT:ExportOffsetDomestic"
  :name "Export-offset domestic VAT / 出口抵减内销产品应纳税额"
  :type :liability
  :external-codes {:cn/asbe "2221.01.06"
                   :cn/asbe-column "出口抵减内销产品应纳税额"}}
 {:code "2221.01.07" :path "Liabilities:Tax:VAT:TransferredUnpaid"
  :name "Transferred unpaid VAT / 转出未交增值税"
  :type :liability
  :external-codes {:cn/asbe "2221.01.07"
                   :cn/asbe-column "转出未交增值税"}}
 {:code "2221.01.08" :path "Liabilities:Tax:VAT:TransferredExcess"
  :name "Transferred excess VAT / 转出多交增值税"
  :type :liability
  :external-codes {:cn/asbe "2221.01.08"
                   :cn/asbe-column "转出多交增值税"}}
 {:code "2221.01.09" :path "Liabilities:Tax:VAT:TaxesPaid"
  :name "Taxes paid (intra-period) / 已交税金"
  :type :liability
  :external-codes {:cn/asbe "2221.01.09"
