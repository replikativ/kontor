;; Brazilian chart of accounts — 5-level dotted-code starter aligned to
;; the Plano de Contas Referencial (RFB) structure. ~60 accounts; the
;; full Plano Referencial (~600-800 lines depending on regime) is a
;; mechanical extension — the kernel + this starter validate the data
;; model.
;;
;; Codes use the 5-level dotted convention: 1.01.01.01.01.
;;
;; Each account carries `:external-codes` per ADR-019:
;;   :br/plano-referencial — the RFB Plano de Contas Referencial code
;;                            used in ECF filing.
;;   :br/sped-contabil     — the SPED Contábil reference code.
;;
;; Per ADR-018 NF-e issuance flows through :pending-attestation; the
;; resulting SEFAZ 44-digit access key (chave de acesso) lands in
;; :transaction/clearance-token.

[
 ;; ---------- 1.01.xx.xx.xx Ativo Circulante (Current Assets) ----------
 {:code "1.01.01.01.01" :path "Assets:Cash:HeadOffice"
  :name "Caixa Matriz / Cash – Head Office"
  :type :asset :reconcilable? false
  :external-codes {:br/plano-referencial "L100A_1.01.01.01.01"}}
 {:code "1.01.01.02.01" :path "Assets:Bank:National"
  :name "Bancos Conta Movimento – No País / Banks – In the Country"
  :type :asset :reconcilable? true
  :external-codes {:br/plano-referencial "L100A_1.01.01.02.01"}}
 {:code "1.01.01.02.02" :path "Assets:Bank:Foreign"
  :name "Bancos Conta Movimento – No Exterior / Banks – Abroad"
  :type :asset :reconcilable? true}
 {:code "1.01.02.01.01" :path "Assets:Investment:Short"
  :name "Aplicações Financeiras de Curto Prazo / Short-Term Investments"
  :type :asset}
 {:code "1.01.03.01.01" :path "Assets:Receivable:Domestic"
  :name "Clientes Nacionais / Domestic Customers"
  :type :asset :reconcilable? true
  :external-codes {:br/plano-referencial "L100A_1.01.03.01.01"}}
 {:code "1.01.03.01.02" :path "Assets:Receivable:Foreign"
  :name "Clientes Estrangeiros / Foreign Customers"
  :type :asset :reconcilable? true}
 {:code "1.01.03.99.01" :path "Assets:Receivable:Allowance"
  :name "(-) Provisão p/ Créditos de Liquidação Duvidosa / Allowance"
  :type :asset}                                          ;; contra
 {:code "1.01.04.01.01" :path "Assets:Inventory:RawMaterials"
  :name "Estoques de Matéria-Prima / Raw Materials"
  :type :asset}
 {:code "1.01.04.02.01" :path "Assets:Inventory:Products"
  :name "Estoques de Produtos Acabados / Finished Goods"
  :type :asset}

 ;; ICMS / IPI / PIS / COFINS receivable (recoverable) accounts
 {:code "1.01.05.01.01" :path "Assets:Tax:ICMS-Recoverable"
  :name "ICMS a Recuperar / ICMS recoverable (input)"
  :type :asset
  :tags [:br-icms-input]}
 {:code "1.01.05.01.02" :path "Assets:Tax:IPI-Recoverable"
