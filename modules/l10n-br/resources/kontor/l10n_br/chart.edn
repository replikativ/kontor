  :type :asset
  :tags [:br-pis-input]}
 {:code "1.01.05.01.04" :path "Assets:Tax:COFINS-Recoverable"
  :name "COFINS a Recuperar (não-cumulativo) / COFINS recoverable"
  :type :asset
  :tags [:br-cofins-input]}
