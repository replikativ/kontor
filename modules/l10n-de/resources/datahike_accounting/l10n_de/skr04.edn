  :type :expense :name "Raumkosten"}
 {:code "6400" :path "Aufwendungen:Raum:Nebenkosten"
  :type :expense :name "Heizung, Strom, Wasser"}
 {:code "6520" :path "Aufwendungen:Versicherungen"
  :type :expense :name "Versicherungen"}
 {:code "6530" :path "Aufwendungen:Beiträge"
  :type :expense :name "Beiträge"}
 {:code "6600" :path "Aufwendungen:Werbung"
  :type :expense :name "Werbung"}
 {:code "6650" :path "Aufwendungen:Reisekosten"
  :type :expense :name "Reisekosten"}
 {:code "6670" :path "Aufwendungen:Bewirtung"
