;; SKR04 — Standardkontenrahmen 04, German chart of accounts.
;;
;; Subset focused on the load-bearing accounts for UStVA / EÜR
;; reporting. Full SKR04 is ~1500 accounts; we ship the ~50 that
;; cover most SMB activity and the VAT report. Customers add the
;; rest by transacting more :account entries.
;;
;; Konto numbers and titles are factual data not under copyright in the EU.
;;
;; Schema fields per account:
;;   :code                 — the four-digit Konto number (string)
;;   :path                 — hierarchical name in PTA notation
;;   :type                 — :asset | :liability | :equity | :income | :expense
;;   :commodity            — defaults to "EUR" if not set
;;   :reconcilable?        — true for AR/AP/bank accounts
;;   :tax-recoverable?     — for input-VAT accounts (1406/1401 etc.)
;;   :tax-payable?         — for output-VAT accounts (3806/3801 etc.)
;;   :tags                 — vector of UStVA box keys this account
;;                           contributes to (e.g. :ust-81 = sales 19%)

[;; ============================================================================
 ;; Klasse 1 — Anlagevermögen (long-term assets)
 ;; ============================================================================
 {:code "0440" :path "Anlagevermögen:Maschinen"
  :type :asset :name "Maschinen"}
 {:code "0690" :path "Anlagevermögen:Geschäftsausstattung"
  :type :asset :name "Sonstige Betriebs- und Geschäftsausstattung"}
 {:code "0670" :path "Anlagevermögen:Geringwertige Wirtschaftsgüter"
  :type :asset :name "Geringwertige Wirtschaftsgüter (GWG)"}

 ;; ============================================================================
 ;; Klasse 1 — Umlaufvermögen (current assets)
 ;; ============================================================================
 {:code "1600" :path "Umlaufvermögen:Kasse"
  :type :asset :name "Kasse" :reconcilable? true}
 {:code "1800" :path "Umlaufvermögen:Bank"
  :type :asset :name "Bank" :reconcilable? true}
 {:code "1810" :path "Umlaufvermögen:Bank:Hauptbank"
  :type :asset :name "Hauptbank" :reconcilable? true}
 {:code "1820" :path "Umlaufvermögen:Bank:Nebenbank"
  :type :asset :name "Nebenbank" :reconcilable? true}
 {:code "1830" :path "Umlaufvermögen:PayPal"
  :type :asset :name "PayPal-Konto" :reconcilable? true}
 {:code "1200" :path "Umlaufvermögen:Forderungen"
  :type :asset :name "Forderungen aus Lieferungen und Leistungen"
  :reconcilable? true}
 {:code "1300" :path "Umlaufvermögen:Forderungen:Sonstige"
  :type :asset :name "Sonstige Vermögensgegenstände" :reconcilable? true}

 ;; Vorsteuer (input tax) accounts — :tax-recoverable? true
 {:code "1401" :path "Umlaufvermögen:Vorsteuer:7%"
  :type :asset :name "Abziehbare Vorsteuer 7%"
  :tax-recoverable? true :tags [:ust-66]}
 {:code "1406" :path "Umlaufvermögen:Vorsteuer:19%"
  :type :asset :name "Abziehbare Vorsteuer 19%"
  :tax-recoverable? true :tags [:ust-66]}
 {:code "1404" :path "Umlaufvermögen:Vorsteuer:Innergemeinschaft"
  :type :asset :name "Abziehbare Vorsteuer aus innergemeinschaftlichem Erwerb 19%"
  :tax-recoverable? true :tags [:ust-66]}
 {:code "1407" :path "Umlaufvermögen:Vorsteuer:Reverse-Charge"
  :type :asset :name "Abziehbare Vorsteuer nach § 13b UStG 19%"
  :tax-recoverable? true :tags [:ust-66]}

 ;; ============================================================================
 ;; Klasse 2 — Eigenkapital (equity)
 ;; ============================================================================
 {:code "2100" :path "Eigenkapital:Privatentnahmen"
  :type :equity :name "Privatentnahmen allgemein"}
 {:code "2180" :path "Eigenkapital:Privateinlagen"
  :type :equity :name "Privateinlagen"}
 {:code "2970" :path "Eigenkapital:Gewinnvortrag"
  :type :equity :name "Gewinnvortrag vor Verwendung"}

 ;; ============================================================================
 ;; Klasse 3 — Verbindlichkeiten (liabilities)
 ;; ============================================================================
 {:code "3300" :path "Verbindlichkeiten:Lieferanten"
  :type :liability :name "Verbindlichkeiten aus Lieferungen und Leistungen"
  :reconcilable? true}

 ;; Umsatzsteuer (output tax) accounts — :tax-payable? true
 {:code "3806" :path "Verbindlichkeiten:Umsatzsteuer:19%"
  :type :liability :name "Umsatzsteuer 19%"
  :tax-payable? true :tags [:ust-81-ust]}
 {:code "3801" :path "Verbindlichkeiten:Umsatzsteuer:7%"
  :type :liability :name "Umsatzsteuer 7%"
  :tax-payable? true :tags [:ust-86-ust]}
 {:code "3802" :path "Verbindlichkeiten:Umsatzsteuer:Innergemeinschaft"
  :type :liability :name "Umsatzsteuer aus innergemeinschaftlichem Erwerb"
  :tax-payable? true :tags [:ust-89-ust]}

 ;; ============================================================================
 ;; Klasse 4 — Erträge (revenue)
 ;; ============================================================================
 {:code "4400" :path "Erträge:Erlöse:19%"
  :type :income :name "Erlöse 19% USt"
  :tags [:ust-81]}
 {:code "4300" :path "Erträge:Erlöse:7%"
  :type :income :name "Erlöse 7% USt"
  :tags [:ust-86]}
 {:code "4120" :path "Erträge:Erlöse:Steuerfrei"
  :type :income :name "Steuerfreie Umsätze nach § 4 Nr. 1a UStG (Ausfuhr)"
  :tags [:ust-43]}
 {:code "4125" :path "Erträge:Erlöse:Innergemeinschaft"
  :type :income :name "Steuerfreie innergem. Lieferungen §4 Nr 1b UStG"
  :tags [:ust-41]}
 {:code "4336" :path "Erträge:Erlöse:Reverse-Charge"
  :type :income :name "Erlöse aus im anderen EU-Land steuerpflichtigen sonstigen Leistungen (§ 3a Abs. 2 UStG)"
  :tags [:ust-21]}
 {:code "4830" :path "Erträge:Sonstige:Erstattungen"
  :type :income :name "Sonstige betriebliche Erträge"}

 ;; ============================================================================
 ;; Klasse 5/6 — Aufwendungen (expenses)
 ;; ============================================================================
 {:code "5400" :path "Aufwendungen:Wareneinkauf"
  :type :expense :name "Wareneingang 19% Vorsteuer"}
 {:code "5900" :path "Aufwendungen:Bezogene Leistungen"
  :type :expense :name "Fremdleistungen"}
 {:code "6020" :path "Aufwendungen:Personal:Gehälter"
  :type :expense :name "Gehälter"}
 {:code "6310" :path "Aufwendungen:Raum:Miete"
  :type :expense :name "Miete (unbewegliche Wirtschaftsgüter)"}
 {:code "6325" :path "Aufwendungen:Raum:Nebenkosten"
  :type :expense :name "Gas, Strom, Wasser"}
 {:code "6400" :path "Aufwendungen:Versicherungen"
  :type :expense :name "Versicherungen"}
 {:code "6420" :path "Aufwendungen:Beiträge"
  :type :expense :name "Beiträge"}
 {:code "6600" :path "Aufwendungen:Werbung"
  :type :expense :name "Werbung"}
 {:code "6650" :path "Aufwendungen:Reisekosten"
  :type :expense :name "Reisekosten"}
 {:code "6640" :path "Aufwendungen:Bewirtung"
  :type :expense :name "Bewirtungskosten"}
 {:code "6815" :path "Aufwendungen:Bürobedarf"
  :type :expense :name "Bürobedarf"}
 {:code "6837" :path "Aufwendungen:Software"
  :type :expense :name "Aufwendungen für Lizenzen, Konzessionen (Software)"}
 {:code "6805" :path "Aufwendungen:Telekommunikation"
  :type :expense :name "Telefon"}
 {:code "6500" :path "Aufwendungen:Fahrzeuge"
  :type :expense :name "Fahrzeugkosten"}
 {:code "6825" :path "Aufwendungen:Steuerberater"
  :type :expense :name "Rechts- und Beratungskosten"}
 {:code "6830" :path "Aufwendungen:Buchhaltung"
  :type :expense :name "Buchführungskosten"}
 {:code "6300" :path "Aufwendungen:Sonstige"
  :type :expense :name "Sonstige betriebliche Aufwendungen"}

 ;; --- Steuern vom Einkommen + Gewerbesteuer (HGB §275 Abs. 2 Nr. 14) ---
 ;; Note 160 §I-18: shipping these so a UG/GmbH consumer doesn't have
 ;; to add tax-side accounts manually.
 {:code "7600" :path "Aufwendungen:Steuern:KSt"
  :type :expense :name "Körperschaftsteuer"}
 {:code "7610" :path "Aufwendungen:Steuern:GewSt"
  :type :expense :name "Gewerbesteuer"}
 {:code "3040" :path "Verbindlichkeiten:Steuern:KSt-Rückstellung"
  :type :liability :reconcilable? true
  :name "Körperschaftsteuerrückstellung"}
 {:code "3035" :path "Verbindlichkeiten:Steuern:GewSt-Rückstellung"
  :type :liability :reconcilable? true
  :name "Gewerbesteuerrückstellung"}

 ;; --- Dividenden / Gewinnausschüttung ---
 {:code "3519" :path "Verbindlichkeiten:Dividenden-Zahlbar"
  :type :liability :reconcilable? true
  :name "Verbindlichkeiten gegenüber Gesellschaftern für offene Ausschüttungen"}
 {:code "3760" :path "Verbindlichkeiten:KESt-Zahlbar"
  :type :liability :reconcilable? true
  :name "Verbindlichkeiten aus Einbehaltung (KapESt und SolZ auf KapESt)"}]
