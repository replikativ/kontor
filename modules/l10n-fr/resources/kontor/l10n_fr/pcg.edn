 {:code "623"  :path "Charges:Publicité"
  :type :expense :name "Publicité, publications, relations publiques"}
 {:code "625"  :path "Charges:Déplacements"
  :type :expense :name "Déplacements, missions et réceptions"}
 {:code "626"  :path "Charges:Télécom"
  :type :expense :name "Frais postaux et télécommunications"}
 {:code "627"  :path "Charges:Banque"
  :type :expense :name "Services bancaires et assimilés"}
 {:code "641"  :path "Charges:Personnel"
