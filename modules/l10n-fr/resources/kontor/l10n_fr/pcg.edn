 ;; Classe 7 — Produits (revenue)
 {:code "706"  :path "Produits:Prestations-services"
  :type :income :name "Prestations de services"
  :tags [:ca3-01-base]}
 {:code "707"  :path "Produits:Ventes-marchandises"
