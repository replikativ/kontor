;; Default chart of accounts for US SMBs (no statutory
;; chart). Account ranges follow a common SMB convention
;; that many bookkeepers use:
;;
;;   1xxx — Assets        (1000=cash; 1100-1199=AR; 1300-1399=ITC/asset taxes)
;;   2xxx — Liabilities   (2000=AP; 2200-2299=sales-tax payable per state)
;;   3xxx — Equity        (owner / retained earnings)
;;   4xxx — Income        (sales / services revenue)
;;   5xxx — COGS
;;   6xxx — Operating expenses
;;   7xxx — Other income / non-operating
;;
;; US sales tax is non-recoverable for the END consumer; for B2B
;; resellers it's their input but they typically use a resale
;; certificate to skip paying it (no input-tax-credit mechanism
;; like VAT). Sales tax COLLECTED on B2C sales is a liability owed
;; to the state DOR; sales tax PAID on inputs (when not exempt) is
;; expense.
;;
;; Tags route postings to per-state filing reports:
;;   :us-{state}-{box} — e.g. :us-tx-line-1 (Texas state sales tax)
;;
;; The chart is SMB-aligned for 1099-NEC contractors,
;; with extension hooks for the typical pain points: per-class fixed
;; assets with accumulated depreciation contras, prepaid expenses,
;; deferred revenue, payroll-liability sub-accounts, and the
;; non-operating 7xxx range for interest / FX / gain-loss postings.

[;; ============================================================================
 ;; 1xxxx — ASSETS
 ;;   10xx — Cash and bank
 ;;   11xx — Bank accounts
 ;;   12xx — Receivables + allowance
 ;;   13xx — Prepaid + other current
 ;;   14xx — Inventory + raw materials
 ;;   15xx — Fixed assets (PP&E gross + accumulated depreciation)
 ;;   16xx — Intangibles + other non-current
 ;; ============================================================================
 ;; --- Cash and bank ---
 {:code "1000" :path "Assets:Cash"
  :type :asset :name "Cash on hand" :reconcilable? true}
 {:code "1100" :path "Assets:Bank:Checking"
  :type :asset :name "Bank — Checking" :reconcilable? true}
 {:code "1110" :path "Assets:Bank:Savings"
  :type :asset :name "Bank — Savings" :reconcilable? true}
 {:code "1120" :path "Assets:Bank:Merchant"
  :type :asset :name "Bank — Merchant / Payment-processor clearing"
  :reconcilable? true}
 {:code "1130" :path "Assets:Bank:Petty-Cash"
  :type :asset :name "Petty cash" :reconcilable? true}

 ;; --- Receivables ---
 {:code "1200" :path "Assets:Receivable"
  :type :asset :name "Accounts receivable" :reconcilable? true}
 {:code "1210" :path "Assets:Receivable:Allowance-Doubtful"
  :type :asset :name "Allowance for doubtful accounts (contra-AR)"}
 {:code "1220" :path "Assets:Receivable:Employee-Advances"
  :type :asset :name "Employee advances and travel-card receivables"
  :reconcilable? true}
 {:code "1230" :path "Assets:Receivable:Notes"
  :type :asset :name "Notes receivable (short-term)"}

 ;; --- Prepaid + other current assets ---
 {:code "1300" :path "Assets:Prepaid:Insurance"
  :type :asset :name "Prepaid insurance"}
 {:code "1310" :path "Assets:Prepaid:Rent"
  :type :asset :name "Prepaid rent"}
 {:code "1320" :path "Assets:Prepaid:Other"
  :type :asset :name "Prepaid expenses — other"}
 {:code "1390" :path "Assets:Deposit:Vendor"
  :type :asset :name "Vendor deposits and refundable holds"}

 ;; --- Inventory ---
 {:code "1500" :path "Assets:Inventory"
  :type :asset :name "Inventory"}
 {:code "1510" :path "Assets:Inventory:Raw-Materials"
  :type :asset :name "Inventory — Raw materials"}
 {:code "1520" :path "Assets:Inventory:Work-in-Process"
  :type :asset :name "Inventory — Work in process"}
 {:code "1530" :path "Assets:Inventory:Finished-Goods"
  :type :asset :name "Inventory — Finished goods"}

 ;; --- Fixed assets (PP&E) ---
 {:code "1550" :path "Assets:Fixed:Land"
  :type :asset :name "Land"}
 {:code "1560" :path "Assets:Fixed:Buildings"
  :type :asset :name "Buildings and leasehold improvements"}
 {:code "1565" :path "Assets:Fixed:Buildings:Accumulated-Depreciation"
  :type :asset :name "Accumulated depreciation — Buildings (contra)"}
 {:code "1570" :path "Assets:Fixed:Vehicles"
  :type :asset :name "Vehicles"}
 {:code "1575" :path "Assets:Fixed:Vehicles:Accumulated-Depreciation"
  :type :asset :name "Accumulated depreciation — Vehicles (contra)"}
 {:code "1580" :path "Assets:Fixed:Furniture-Equipment"
  :type :asset :name "Furniture and equipment"}
 {:code "1585" :path "Assets:Fixed:Furniture-Equipment:Accumulated-Depreciation"
  :type :asset :name "Accumulated depreciation — Furniture/Equipment (contra)"}
 {:code "1590" :path "Assets:Fixed:Computer-Equipment"
  :type :asset :name "Computer hardware and software (capitalized)"}
 {:code "1595" :path "Assets:Fixed:Computer-Equipment:Accumulated-Depreciation"
  :type :asset :name "Accumulated depreciation — Computer Equipment (contra)"}

 ;; --- Intangibles + other non-current ---
 {:code "1600" :path "Assets:Intangibles:Software"
  :type :asset :name "Internally-developed software (capitalized)"}
 {:code "1610" :path "Assets:Intangibles:Goodwill"
  :type :asset :name "Goodwill (purchase accounting)"}
 {:code "1700" :path "Assets:Deposit:Security"
  :type :asset :name "Security deposits (long-term)"}

 ;; ============================================================================
 ;; 2xxxx — LIABILITIES
 ;;   20xx — Trade payables + accrued
 ;;   21xx — Other current liabilities (credit card, customer deposits)
 ;;   22xx — Sales-tax payable per state
 ;;   23xx — Payroll liabilities
 ;;   24xx — Federal payroll / 1099 accruals
 ;;   25xx — Income tax payable
 ;;   26xx — Notes payable + lines of credit (short-term)
 ;;   27xx — Long-term liabilities
 ;; ============================================================================
 {:code "2000" :path "Liabilities:Payable"
  :type :liability :name "Accounts payable" :reconcilable? true}
 {:code "2010" :path "Liabilities:Accrued-Expenses"
  :type :liability :name "Accrued expenses"}
 {:code "2020" :path "Liabilities:Accrued:Interest"
  :type :liability :name "Accrued interest payable"}

 {:code "2100" :path "Liabilities:Credit-Card"
  :type :liability :name "Credit card payable (corporate cards)"
  :reconcilable? true}
 {:code "2110" :path "Liabilities:Customer-Deposits"
  :type :liability :name "Customer deposits / advance payments"
  :reconcilable? true}
 {:code "2120" :path "Liabilities:Deferred-Revenue"
  :type :liability :name "Deferred revenue (unearned income)"}
 {:code "2130" :path "Liabilities:Gift-Cards"
  :type :liability :name "Gift card / store credit liability"}

 ;; Sales tax payable per state — one liability account per state we
 ;; collect from. Tags reference the per-state filing-report box.
 {:code "2210" :path "Liabilities:SalesTax:CA"
  :type :liability :name "California sales tax payable"
  :tax-payable? true :tags [:us-ca-state-line-1]}
 {:code "2211" :path "Liabilities:SalesTax:TX"
  :type :liability :name "Texas sales tax payable"
  :tax-payable? true :tags [:us-tx-state-line-1]}
 {:code "2212" :path "Liabilities:SalesTax:NY"
  :type :liability :name "New York sales tax payable"
  :tax-payable? true :tags [:us-ny-state-line-1]}
 {:code "2213" :path "Liabilities:SalesTax:WA"
  :type :liability :name "Washington sales tax payable"
  :tax-payable? true :tags [:us-wa-state-line-1]}
 {:code "2214" :path "Liabilities:SalesTax:FL"
  :type :liability :name "Florida sales tax payable"
  :tax-payable? true :tags [:us-fl-state-line-1]}
 ;; Local sub-accounts for jurisdictions that file separately
 ;; (Colorado home-rule cities, Alabama self-administered cities,
 ;; LA parishes). One sample below; add per-customer.
 {:code "2230" :path "Liabilities:SalesTax:CO-Denver"
  :type :liability :name "Denver, CO sales tax payable (home-rule city)"
  :tax-payable? true :tags [:us-co-denver-line-1]}

 ;; --- Payroll liabilities ---
 {:code "2300" :path "Liabilities:Payroll:Wages-Salaries"
  :type :liability :name "Wages and salaries payable"}
 {:code "2310" :path "Liabilities:Payroll:State-Withholding"
  :type :liability :name "State income tax withheld"}
 {:code "2320" :path "Liabilities:Payroll:FUTA"
  :type :liability :name "FUTA — Federal unemployment tax payable"}
 {:code "2330" :path "Liabilities:Payroll:SUTA"
