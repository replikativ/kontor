 {:code "2510" :path "Liabilities:Income-Tax:State"
  :type :liability :name "State income tax payable (corporate / franchise)"}

 ;; --- Short-term debt ---
 {:code "2600" :path "Liabilities:Short-term-Debt:Line-of-Credit"
  :type :liability :name "Line of credit — current portion"
  :reconcilable? true}
 {:code "2610" :path "Liabilities:Short-term-Debt:Notes"
  :type :liability :name "Notes payable — current portion"
  :reconcilable? true}

 ;; --- Long-term debt ---
 {:code "2700" :path "Liabilities:Long-term-Debt:Notes"
  :type :liability :name "Notes payable — long-term"
  :reconcilable? true}
 {:code "2710" :path "Liabilities:Long-term-Debt:Mortgage"
  :type :liability :name "Mortgage payable — long-term"
  :reconcilable? true}

 ;; ============================================================================
 ;; 3xxx — EQUITY
 ;;   30xx — Owner / member contributions + distributions
