 :deps
 {org.clojure/clojure              {:mvn/version "1.12.4"}
  ;; 0.8.1734: bitemporal-v1 in mainline + the query planner (default-on
  ;; since 0.8.1705). 0.8.1734 fixes the planner scope-leak bugs (#883)
  ;; surfaced by kontor's invariants + report queries (nested-q function-var
  ;; scope leak; variable-binding type confusion). Kept in step with simmis.
  org.replikativ/datahike          {:mvn/version "0.8.1734"}
  ;; ADR-011's declarative datalog invariants now live inline at
  ;; `kontor.invariant` (vendored from datopia/invariant, MIT, maintained
  ;; by us). Single-dep posture per ADR-001 preserved.
  ;; Beancount parser (Phase 1 acceptance test — ADR-009). Small EPL
  ;; library, no further transitive deps to speak of.
  instaparse/instaparse            {:mvn/version "1.5.0"}
  ;; CSV parsing — used by modules/bank-de. EPL.
  org.clojure/data.csv             {:mvn/version "1.1.0"}
  ;; XML generation — used by modules/l10n-ca/.../xml/ for CRA
  ;; information-return XML (T4 / T5 / T5018) per ADR-015. EPL.
  org.clojure/data.xml             {:mvn/version "0.2.0-alpha9"}
  ;; JSON — used by modules/l10n-in/.../irn for the NIC IRP payload
  ;; (ADR-024 multi-attestation). EPL.
  org.clojure/data.json            {:mvn/version "2.5.0"}
  ;; Mustang — Factur-X / XRechnung / ZUGFeRD generation + embedding.
  ;; APL-2. Used by modules/einvoice-de. Heavy: pulls iText, Apache PDFBox,
  ;; XOM, etc., so kernel-only consumers can drop this entry from their
  ;; deps.edn at packaging time.
  org.mustangproject/library       {:mvn/version "2.17.0"}}

