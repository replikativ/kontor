;; kontor — double-entry accounting kernel on datahike.
;;
;; Kernel deps are deliberately minimal. Country-specific data,
;; e-invoicing wrappers, and bank-statement importers ship as separate
;; artifacts (see doc/architecture.md).
;; Monorepo layout (per ADR-006 + iteration-speed concerns):
;; the kernel ships from src/ + resources/; per-country / per-bank /
;; per-format modules under modules/<name>/. Each module's src/ + test/
;; + resources/ live next to its own README, but ALL paths are merged
;; here so a single REPL / single bb ci sees the whole tree. When a
;; module hardens enough to have external consumers, it can be split
;; into its own artifact without code changes — only deps.edn moves.
{:paths ["src" "resources"
         ;; substrate — dep-light value layer (kontor.money); own deps.edn
         ;; because dvergr consumes it standalone. See modules/substrate/README.
         "modules/substrate/src"
         ;; metering — usage-subledger → GL accrual summarizer (note 190 Piece C)
         "modules/metering/src"
         "modules/partner/src"     "modules/partner/resources"
         "modules/sales/src"       "modules/sales/resources"
         "modules/invoice/src"     "modules/invoice/resources"
         "modules/procurement/src" "modules/procurement/resources"
         "modules/collections/src" "modules/collections/resources"
         "modules/asset/src"       "modules/asset/resources"
         "modules/inventory/src"   "modules/inventory/resources"
         "modules/expense/src"     "modules/expense/resources"
         "modules/lease/src"       "modules/lease/resources"
         "modules/hr/src"          "modules/hr/resources"
         "modules/payroll-us-adp/src" "modules/payroll-us-adp/resources"
         "modules/l10n-de/src"     "modules/l10n-de/resources"
         "modules/l10n-at/src"     "modules/l10n-at/resources"
         "modules/l10n-fr/src"     "modules/l10n-fr/resources"
         "modules/l10n-ca/src"     "modules/l10n-ca/resources"
         "modules/l10n-us/src"     "modules/l10n-us/resources"
         "modules/l10n-jp/src"     "modules/l10n-jp/resources"
         "modules/l10n-au/src"     "modules/l10n-au/resources"
         "modules/l10n-cn/src"     "modules/l10n-cn/resources"
         "modules/l10n-br/src"     "modules/l10n-br/resources"
         "modules/l10n-in/src"     "modules/l10n-in/resources"
         "modules/l10n-mx/src"     "modules/l10n-mx/resources"
         "modules/l10n-uk/src"     "modules/l10n-uk/resources"
         "modules/payroll-ca/src"  "modules/payroll-ca/resources"
         "modules/payroll-jp/src"  "modules/payroll-jp/resources"
         "modules/payroll-br/src"  "modules/payroll-br/resources"
         "modules/payroll-fr/src"  "modules/payroll-fr/resources"
         "modules/payroll-au/src"  "modules/payroll-au/resources"
         "modules/payroll-in/src"  "modules/payroll-in/resources"
