  ;; ClojureScript test lane (Phase 0, research note 191). shadow-cljs
  ;; reads this alias for the cljs classpath; the substrate `.cljc` units
  ;; compile to a Node bundle so portability is verified in CI.
  ;; fress supplies the browser BigDecimal (fress.impl.bigdec) that
  ;; kontor.money's cljs branch uses; kept as a local dep until the
  ;; upstream BIGDEC-handler release lands (pkpkpk/fress#8).
  ;; Run: clojure -M:cljs -m shadow.cljs.devtools.cli compile node-test
  ;;      && node target/node-test.js
  :cljs
  ;; cljs build runs against the local datahike worktree carrying the
  ;; :db.type/bigdec fix (branch fix/cljs-bigdec-schema — accept the fress
  ;; Bigdec). Build its Java first: (cd ../datahike-bigdec && bb jcompile).
  ;; JVM :test stays on the Maven 0.8.1734 pin; repoint both once the fix ships.
  {:extra-paths ["modules/substrate/test"]
   :extra-deps  {org.clojure/clojurescript {:mvn/version "1.12.134"}
                 thheller/shadow-cljs      {:mvn/version "3.3.6"}
                 org.replikativ/datahike   {:local/root "../datahike-bigdec"}
                 com.github.pkpkpk/fress    {:local/root "../fress"}}}

